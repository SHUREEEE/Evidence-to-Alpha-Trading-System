{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-alpha.local/schemas/news_enrichment.schema.json",
  "title": "Point-in-Time News Event Enrichment",
  "type": "object",
  "required": [
    "schema_version",
    "enrichment_type",
    "generated_at",
    "source",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "enrichment_type": {"const": "news_event_enrichment"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": [
        "synthetic",
        "repository",
        "commit",
        "pipeline_run_id",
        "methodology",
        "input_artifacts"
      ],
      "properties": {
        "synthetic": {"const": false},
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "pipeline_run_id": {"type": "string", "minLength": 1},
        "methodology": {"type": "string", "minLength": 1},
        "input_artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["artifact_type", "artifact", "sha256"],
            "properties": {
              "artifact_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              },
              "artifact": {"type": "string", "minLength": 1},
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            },
            "additionalProperties": false
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "artifact_type": {"const": "news_claws_sqlite_snapshot"}
                },
                "required": ["artifact_type"]
              }
            },
            {
              "contains": {
                "properties": {
                  "artifact_type": {"const": "news_export_events"}
                },
                "required": ["artifact_type"]
              }
            }
          ]
        },
        "selection": {
          "type": "object",
          "required": [
            "policy",
            "requested_event_refs",
            "enriched_event_refs",
            "unresolved_event_refs"
          ],
          "properties": {
            "policy": {
              "enum": ["all_requested", "eligible_published_at_only"]
            },
            "requested_event_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "enriched_event_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "unresolved_event_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "event_version",
          "available_at",
          "source_urls"
        ],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "event_version": {"type": "integer", "minimum": 1},
          "available_at": {"type": "string", "format": "date-time"},
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uri"}
          },
          "published_at": {"type": "string", "format": "date-time"},
          "novelty": {"type": "number", "minimum": 0, "maximum": 1},
          "mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity",
                "ticker",
                "sector",
                "effective_from",
                "source_url"
              ],
              "properties": {
                "entity": {"type": "string", "minLength": 1},
                "ticker": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9.^-]{1,20}$"
                },
                "sector": {"type": "string", "minLength": 1},
                "impact_multiplier": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 2
                },
                "effective_from": {"type": "string", "format": "date"},
                "effective_to": {
                  "oneOf": [
                    {"type": "string", "format": "date"},
                    {"type": "null"}
                  ]
                },
                "source_url": {"type": "string", "format": "uri"}
              },
              "additionalProperties": false
            }
          }
        },
        "anyOf": [
          {"required": ["published_at"]},
          {"required": ["novelty"]},
          {
            "required": ["mappings"],
            "properties": {"mappings": {"minItems": 1}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
