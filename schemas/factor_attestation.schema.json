{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidence-alpha.local/schemas/factor_attestation.schema.json",
  "title": "Production Factor Weights Attestation",
  "type": "object",
  "required": ["schema_version", "attestation_type", "artifact", "production", "quality"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "attestation_type": {"const": "factor_weights"},
    "artifact": {
      "type": "object",
      "required": ["sha256", "coverage_start", "coverage_end"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "coverage_start": {"type": "string", "format": "date"},
        "coverage_end": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "required": [
        "synthetic",
        "source_repository",
        "source_commit",
        "pipeline_run_id",
        "generated_at"
      ],
      "properties": {
        "synthetic": {"const": false},
        "source_repository": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "pipeline_run_id": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": [
        "point_in_time",
        "universe_membership_point_in_time",
        "unresolved_exceptions"
      ],
      "properties": {
        "point_in_time": {"const": true},
        "universe_membership_point_in_time": {"const": true},
        "unresolved_exceptions": {"type": "array", "maxItems": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
