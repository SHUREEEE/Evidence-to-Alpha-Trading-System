{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/event_snapshot.schema.json",
  "title": "Event Snapshot Version",
  "type": "object",
  "required": [
    "event_id", "event_version", "published_at", "observed_at", "event_type",
    "direction", "confidence", "novelty", "conflict", "impact_horizon_days",
    "entities", "evidence_ids", "status", "asof"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_version": {"type": "integer", "minimum": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string", "minLength": 1},
    "direction": {"enum": ["positive", "negative", "neutral", "uncertain"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "novelty": {"type": "number", "minimum": 0, "maximum": 1},
    "conflict": {"type": "boolean"},
    "impact_horizon_days": {"type": "integer", "minimum": 1},
    "entities": {"type": "array", "items": {"type": "string"}},
    "sectors": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string"},
    "asof": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
